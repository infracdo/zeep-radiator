from minio import Minio
import pandas as pd
import psycopg2
import io
import schedule
import time
import json
from datetime import datetime

# === CONFIGURATION ===

MINIO_ENDPOINT = "your-minio-host:9000"
MINIO_ACCESS_KEY = "your-access-key"
MINIO_SECRET_KEY = "your-secret-key"
BUCKET_NAME = "openobserve"
METRICS_PREFIX = "default/metrics/prometheus/"

PG_HOST = "localhost"
PG_DB = "test"
PG_USER = "postgres"
PG_PASSWORD = "your-db-password"

# === CONNECTION SETUP ===

minio_client = Minio(
    MINIO_ENDPOINT,
    access_key=MINIO_ACCESS_KEY,
    secret_key=MINIO_SECRET_KEY,
    secure=False  # Set to True if using HTTPS
)

pg_conn = psycopg2.connect(
    host=PG_HOST,
    dbname=PG_DB,
    user=PG_USER,
    password=PG_PASSWORD
)
pg_cursor = pg_conn.cursor()

# Keep track of processed files (temporary in-memory)
processed_files = set()

# === ETL LOGIC ===

def process_parquet_files():
    print("🔍 Scanning MinIO for new Parquet files...")
    objects = minio_client.list_objects(BUCKET_NAME, prefix=METRICS_PREFIX, recursive=True)

    for obj in objects:
        if not obj.object_name.endswith(".parquet") or obj.object_name in processed_files:
            continue

        print(f"📂 Processing {obj.object_name}")
        response = minio_client.get_object(BUCKET_NAME, obj.object_name)
        parquet_bytes = io.BytesIO(response.read())
        df = pd.read_parquet(parquet_bytes)

        for _, row in df.iterrows():
            ts_micro = row.get("__timestamp")
            ts = datetime.utcfromtimestamp(ts_micro / 1_000_000) if ts_micro else None

            metric_name = row.get("__name__", "unknown")
            value = row.get("value", None)
            namespace = row.get("namespace", "unknown")
            pod = row.get("pod", "unknown")
            container = row.get("container", "unknown")
            node = row.get("node", "unknown")
            instance = row.get("instance", "unknown")
            job = row.get("job", "unknown")

            pg_cursor.execute("""
                INSERT INTO metrics (timestamp, metric_name, value, namespace, pod, container, node, instance, job)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s, %s)
            """, (ts, metric_name, value, namespace, pod, container, node, instance, job))

        pg_conn.commit()
        processed_files.add(obj.object_name)
        print(f"✅ Done: {obj.object_name}")

# === SCHEDULER ===

schedule.every(1).hours.do(process_parquet_files)

print("🚀 Starting scheduled ETL from MinIO to PostgreSQL...")
while True:
    schedule.run_pending()
    time.sleep(60)
