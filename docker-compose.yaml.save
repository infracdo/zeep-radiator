services:

  radiator:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: radiator
    ports:
      - "1812:1812/udp"
      - "1813:1813/udp"
    volumes:
      - ./radiator.conf:/etc/radiator/radiator.conf:ro
      - ./certs:/etc/radiator/certs:ro
      - ./logs:/var/log/radiator  # Optional: persist logs on host
    environment:
      DB_HOST:         DBSource        dbi:Pg:dbname=radius;host=192.168.43.121;port=5432
        DBUsername      radiator
        DBAuth          ap0ll0ap0ll0
      DB_PORT: 5432
      DB_USER: user
      DB_PASSWORD: password
      DB_NAME: radiator
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"
    restart: unless-stopped
